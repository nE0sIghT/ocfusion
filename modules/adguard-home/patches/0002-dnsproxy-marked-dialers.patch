 	dialer := &net.Dialer{
 		Timeout: timeout,
+		Control: func(_, address string, connection syscall.RawConn) error {
+			host, _, err := net.SplitHostPort(address)
+			if err != nil {
+				return err
+			}
+
+			if os.Getenv("OCF_DNS_VPN") == "true" {
