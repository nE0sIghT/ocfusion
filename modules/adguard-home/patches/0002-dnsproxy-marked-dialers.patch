+				return nil
+			}
+
+			mark, err := strconv.ParseUint(value, 0, 32)
+			if err != nil {
+				return err
+			}
+
+			var socketErr error
+			err = connection.Control(func(fd uintptr) {
+				socketErr = syscall.SetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_MARK, int(mark))
+			})
+			if err != nil {
+				return err
+			}
+
+			return socketErr
+		},
 	}
 
