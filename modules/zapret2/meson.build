zapret_adapter = custom_target(
    'ocfusion-zapret2',
    input: files(
        'daemon/go.mod',
        'daemon/go.sum',
        'daemon/config.go',
        'daemon/destinations.go',
        'daemon/rules.go',
        'daemon/history.go',
        'daemon/health.go',
        'daemon/traffic.go',
        'daemon/application_strategy.go',
        'daemon/service_catalog.go',
        'daemon/service_fetch.go',
        'daemon/service_store.go',
        'daemon/strategy.go',
        'daemon/presets.go',
        'daemon/scan.go',
        'daemon/scan_targets.go',
        'daemon/scan_refine.go',
        'daemon/scan_runner.go',
        'daemon/scan_probe.go',
        'daemon/scan_udp.go',
        'daemon/scan_worker.go',
        'daemon/firewall.go',
        'daemon/main.go',
        'daemon/log.go',
    ),
    output: ['ocfusion-zapret2', 'zapret2-Go-dependencies.txt'],
    depend_files: go_builder,
    command: [
        python,
        go_builder,
        '--go',
        go.full_path(),
        '--module',
        source_root / 'modules/zapret2/daemon',
        '--output',
        '@OUTPUT0@',
        '--notices',
        '@OUTPUT1@',
        '--version',
        version,
        '--revision',
        revision,
    ],
)

module_specs += {
    'zapret2': {
        'binaries': [external_targets['zapret2'][0], zapret_adapter[0]],
        'assets': files(
            'packaging/module.json.in',
            'ui/index.html',
            'ui/app.js',
            'ui/rules.js',
            'ui/monitoring.js',
            'ui/discovery.js',
            'ui/applications.js',
            'lua/ocfusion-strategies.lua',
            'ui/lists.js',
            'ui/layout.js',
            'ui/targets.js',
            'ui/layout.css',
            'ui/translations.js',
        ),
        'generated_data': [
            {
                'source': external_targets['zapret2'][1],
                'name': 'lua/zapret-lib.lua',
            },
            {
                'source': external_targets['zapret2'][2],
                'name': 'lua/zapret-antidpi.lua',
            },
            {
                'source': external_targets['zapret2'][3],
                'name': 'lua/dtls_clienthello_w3_org.bin',
            },
            {
                'source': external_targets['zapret2'][4],
                'name': 'lua/wireguard_initiation.bin',
            },
            {
                'source': external_targets['zapret2'][5],
                'name': 'lua/stun.bin',
            },
            {
                'source': external_targets['zapret2'][6],
                'name': 'lua/discord-ip-discovery-with-port.bin',
            },
        ],
        'notices': [
            zapret_adapter[1].full_path(),
            build_root / 'licenses/zapret2-license.txt',
            build_root / 'licenses/zapret2-compatibility-headers.txt',
            build_root / 'licenses/libmnl-COPYING.txt',
            build_root / 'licenses/libnfnetlink-COPYING.txt',
            build_root / 'licenses/libnetfilter_queue-COPYING.txt',
            build_root / 'licenses/Lua-license.html',
            build_root / 'licenses/zlib-README.txt',
            build_root / 'licenses/musl-COPYRIGHT.txt',
        ],
    },
}
