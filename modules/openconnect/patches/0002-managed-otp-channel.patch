+#ifndef _WIN32
+static char *ocf_manual_otp(void)
+{
+    struct pollfd descriptor = { .fd = 4, .events = POLLIN };
+    char code[10];
+    size_t length = 0;
+
+    if (write(3, "otp\n", 4) != 4) {
+        return NULL;
+    }
+
+    while (length < sizeof(code) - 1) {
+        if (poll(&descriptor, 1, 120000) <= 0) {
+            return NULL;
+        }
+
+        if (read(4, &code[length], 1) != 1) {
+            return NULL;
+        }
+
+        if (code[length] == '\n') {
+            break;
+        }
+
+        if (code[length] < '0' || code[length] > '9') {
+            return NULL;
+        }
+
+        length++;
+    }
+
+    if (length != 6 && length != 8) {
+        return NULL;
+    }
+
+    code[length] = 0;
+    return strdup(code);
+}
+#endif
