{
  "schema": 1,
  "id": "vpn",
  "name": "VPN integration",
  "version": "@VERSION@",
  "module_api": 1,
  "provides_api": 1,
  "entrypoint": "bin/ocfusion-vpn",
  "install": true,
  "transaction_hooks": true,
  "state_paths": [
    "/jffs/ocfusion-vpn"
  ],
  "stock_pages": [
    {
      "path": "/VPN/vpnc.html",
      "script": "ui/fusion.js"
    }
  ],
  "capabilities": [
    "network.tun",
    "network.policy",
    "network.firewall",
    "asus.fusion.sdn"
  ],
  "resources": {"asus.vpn_allocator": "owned"}
}
