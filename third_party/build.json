{
  "schema": 1,
  "environment": {
    "CFLAGS": "{c_flags}",
    "AR": "aarch64-linux-gnu-ar",
    "RANLIB": "aarch64-linux-gnu-ranlib"
  },
  "static_environment": {
    "CC": "{prefix}/bin/musl-gcc",
    "PKG_CONFIG_LIBDIR": "{prefix}/lib/pkgconfig",
    "PKG_CONFIG_PATH": "{prefix}/lib/pkgconfig",
    "CPPFLAGS": "-I{prefix}/include",
    "LDFLAGS": "-L{prefix}/lib -static"
  },
  "components": {
    "musl": {
      "configure": [
        "./configure",
        "--target=aarch64-linux-musl",
        "--prefix={prefix}",
        "--disable-shared",
        "--enable-wrapper=gcc"
      ],
      "uses_musl": false,
      "license_file": "COPYRIGHT",
      "notice_file": "musl-COPYRIGHT.txt",
      "install_target": "install",
      "environment": {
        "CC": "aarch64-linux-gnu-gcc"
      },
      "kernel_headers": [
        "linux",
        "asm",
        "asm-generic"
      ]
    },
    "zlib": {
      "configure": [
        "./configure",
        "--static",
        "--prefix={prefix}"
      ],
      "uses_musl": true,
      "license_file": "README",
      "notice_file": "zlib-README.txt",
      "install_target": "install"
    },
    "openssl": {
      "configure": [
        "./Configure",
        "linux-aarch64",
        "no-shared",
        "no-module",
        "no-tests",
        "no-legacy",
        "no-engine",
        "--prefix={prefix}",
        "--libdir=lib",
        "--openssldir=/jffs/ocfusion/ssl"
      ],
      "uses_musl": true,
      "license_file": "LICENSE.txt",
      "notice_file": "OpenSSL-Apache-2.0.txt",
      "install_target": "install_sw"
    },
    "libxml2": {
      "configure": [
        "./configure",
        "--host=aarch64-linux-musl",
        "--prefix={prefix}",
        "--disable-shared",
        "--enable-static",
        "--without-python",
        "--without-lzma",
        "--without-iconv",
        "--without-icu",
        "--without-readline",
        "--without-http",
        "--without-ftp",
        "--without-modules"
      ],
      "uses_musl": true,
      "license_file": "Copyright",
      "notice_file": "libxml2-Copyright.txt",
      "install_target": "install"
    },
    "openconnect": {
      "configure": [
        "./configure",
        "--host=aarch64-linux-musl",
        "--prefix=/jffs/ocfusion",
        "--disable-shared",
        "--enable-static",
        "--disable-nls",
        "--without-gnutls",
        "--with-openssl",
        "--without-libproxy",
        "--without-stoken",
        "--without-libpcsclite",
        "--without-libpskc",
        "--without-gssapi",
        "--without-lz4",
        "--without-libp11",
        "--with-vpnc-script=/jffs/ocfusion/vpnc-script"
      ],
      "uses_musl": true,
      "license_file": "COPYING.LGPL",
      "notice_file": "OpenConnect-LGPL-2.1.txt",
      "install_target": null,
      "environment": {
        "LIBS": "-lxml2 -lz -lm -lpthread -ldl",
        "LIBXML2_CFLAGS": "-I{prefix}/include/libxml2",
        "LIBXML2_LIBS": "{prefix}/lib/libxml2.a -lz -lm",
        "OPENSSL_CFLAGS": "-I{prefix}/include",
        "OPENSSL_LIBS": "{prefix}/lib/libssl.a {prefix}/lib/libcrypto.a -ldl -pthread",
        "RPM_PACKAGE_VERSION": "{source_version}",
        "RPM_PACKAGE_RELEASE": "ocfusion1"
      },
      "patches": [
        "modules/openconnect/patches/0001-managed-hook-environment.patch",
        "modules/openconnect/patches/0002-managed-otp-channel.patch"
      ],
      "remove_before_make": [
        "version.c",
        "openconnect",
        "tests/serverhash",
        "tests/bad_dtls_test",
        "tests/lzstest",
        "tests/seqtest",
        "tests/buftest"
      ],
      "make_arguments": [
        "LDFLAGS=-L{prefix}/lib -all-static"
      ],
      "executable": "openconnect"
    },
    "3proxy": {
      "configure": null,
      "uses_musl": true,
      "license_file": "copying",
      "notice_file": "3proxy-license.txt",
      "install_target": null,
      "make_arguments": [
        "-f",
        "Makefile.Linux",
        "CC={prefix}/bin/musl-gcc",
        "LN={prefix}/bin/musl-gcc",
        "STATIC=true",
        "OPENSSL_CHECK=false",
        "WOLFSSL_CHECK=false",
        "PAM_CHECK=false",
        "EXTRA_CFLAGS={c_flags}"
      ],
      "executable": "bin/3proxy"
    },
    "libmnl": {
      "configure": [
        "./configure",
        "--host=aarch64-linux-musl",
        "--prefix={prefix}",
        "--disable-shared",
        "--enable-static",
        "--disable-doxygen"
      ],
      "uses_musl": true,
      "license_file": "COPYING",
      "notice_file": "libmnl-COPYING.txt",
      "install_target": "install"
    },
    "libnfnetlink": {
      "configure": [
        "./configure",
        "--host=aarch64-linux-musl",
        "--prefix={prefix}",
        "--disable-shared",
        "--enable-static",
        "--disable-doxygen"
      ],
      "uses_musl": true,
      "license_file": "COPYING",
      "notice_file": "libnfnetlink-COPYING.txt",
      "install_target": "install"
    },
    "libnetfilter_queue": {
      "configure": [
        "./configure",
        "--host=aarch64-linux-musl",
        "--prefix={prefix}",
        "--disable-shared",
        "--enable-static",
        "--disable-doxygen"
      ],
      "uses_musl": true,
      "license_file": "COPYING",
      "notice_file": "libnetfilter_queue-COPYING.txt",
      "install_target": "install"
    },
    "lua": {
      "configure": null,
      "uses_musl": true,
      "license_file": "doc/readme.html",
      "notice_file": "Lua-license.html",
      "install_target": "install",
      "make_arguments": [
        "PLAT=linux",
        "CC={prefix}/bin/musl-gcc",
        "AR=aarch64-linux-gnu-ar rcu",
        "RANLIB=aarch64-linux-gnu-ranlib",
        "MYCFLAGS={c_flags}",
        "MYLDFLAGS=-static",
        "INSTALL_TOP={prefix}"
      ]
    },
    "zapret2": {
      "configure": null,
      "uses_musl": true,
      "license_file": "docs/LICENSE.txt",
      "notice_file": "zapret2-license.txt",
      "install_target": null,
      "make_arguments": [
        "-C",
        "nfq2",
        "CC={prefix}/bin/musl-gcc",
        "LUA_JIT=0",
        "LUA_CFLAGS=-I{prefix}/include",
        "LUA_LIB={prefix}/lib/liblua.a",
        "CFLAGS={c_flags} -std=gnu99 -I{prefix}/include",
        "LDFLAGS=-L{prefix}/lib -static -Wl,--gc-sections",
        "LIBS_LINUX=-lnetfilter_queue -lnfnetlink -lmnl -lz -lm -ldl"
      ],
      "executable": "nfq2/nfqws2",
      "runtime_files": [
        "lua/zapret-lib.lua",
        "lua/zapret-antidpi.lua",
        "files/fake/dtls_clienthello_w3_org.bin",
        "files/fake/wireguard_initiation.bin",
        "files/fake/stun.bin",
        "files/fake/discord-ip-discovery-with-port.bin"
      ],
      "extra_license_files": [
        "nfq2/uthash.h",
        "nfq2/kavl.h",
        "nfq2/crypto/aes.c",
        "nfq2/crypto/sha.h",
        "nfq2/crypto/gcm.c"
      ],
      "patches": [
        "modules/zapret2/patches/0001-pass-unmatched-tls-before-reassembly.patch",
        "modules/zapret2/patches/0002-retry-transient-replay-errors.patch"
      ]
    }
  }
}
